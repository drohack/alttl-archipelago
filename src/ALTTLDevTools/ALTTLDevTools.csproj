<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research probe for A Little To The Left. Dumps the game's level tables
       and logs gameplay events so the randomizer design can be built against
       real data. Never shipped.

       Prerequisites: src\GameDir.props pointing at an ALTTL install with
       BepInEx (IL2CPP) installed and launched once, which generates the
       interop assemblies referenced below. The game must be CLOSED when
       building - the deploy step cannot overwrite a loaded DLL. -->

  <Import Project="..\GameDir.props" Condition="Exists('..\GameDir.props')" />

  <Target Name="EnsureGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)')"
           Text="GameDir is not set or does not exist. Copy src\GameDir.props.example to src\GameDir.props and point it at your A Little To The Left install." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ALTTLDevTools</AssemblyName>
    <RootNamespace>ALTTLDevTools</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>annotations</Nullable>
    <!-- The game, BepInEx and the virtual-desktop COM interface are all
         Windows-only, so the platform-compatibility analyser has nothing
         useful to say here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)ALTTLDevTools.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(GameDir)\BepInEx\plugins\ALTTLDevTools" />
    <Message Importance="high" Text="Deployed ALTTLDevTools to $(GameDir)\BepInEx\plugins\ALTTLDevTools" />
  </Target>

</Project>
