<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rules and state of the randomizer as pure C#.

       THIS PROJECT MUST NEVER REFERENCE UNITY, BEPINEX, OR THE GAME'S INTEROP
       ASSEMBLIES. Ordinary .NET packages are allowed.

       CI protects the rule by building this project alone on a runner with no
       game installed, and that job is the real guarantee: anything needing the
       game cannot compile there.

       The rule used to ban <PackageReference> too, which was stricter than the
       boundary it defends and cost real coverage. Archipelago.MultiClient.Net
       is an ordinary NuGet package that restores and runs fine on a bare
       runner, so banning it protected nothing while leaving four Unity-FREE
       files - the connection, the inventory, the goal latch and the run state -
       stranded in the plugin project with no tests. Two of the five bugs the
       2026-09-04 audit found were in exactly that untested code.

       So: packages by exception, listed below with a reason. Anything that
       drags in the game does not belong here at all. -->


  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ALTTLArchipelago.Core</AssemblyName>
    <RootNamespace>ALTTLArchipelago.Core</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only package, and only for the enums and value types the protocol
         defines - the refusal codes. No socket is opened from here. It is an
         ordinary .NET library that restores and runs on a runner with no game
         installed, which is why allowing it costs the boundary nothing. -->
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
  </ItemGroup>

</Project>
