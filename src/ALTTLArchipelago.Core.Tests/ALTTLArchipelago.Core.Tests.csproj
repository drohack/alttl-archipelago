<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ALTTLArchipelago.Core\ALTTLArchipelago.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The shipped data table, so tests can assert against the real thing and
       not only against fixtures. A bad regeneration after a game update should
       fail here rather than in a seed someone is playing. -->
  <ItemGroup>
    <None Include="..\..\apworld\alttl\data\levels.json"
          Link="levels.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\apworld\alttl\data\abilities.json"
          Link="abilities.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The prefab survey, so SurveyCrossCheckTests can hold the runtime table
         up against the authored structure. It sees inactive children, which is
         the only static way to know what a PHASED level will eventually need
         of the player. -->
    <None Include="..\..\docs\data\controller-survey.tsv"
          Link="controller-survey.tsv"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
